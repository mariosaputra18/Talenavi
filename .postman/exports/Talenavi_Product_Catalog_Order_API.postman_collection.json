          }
        },
        {
          "name": "Get Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": "mouse",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "electronics",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "newest",
                  "disabled": true
                }
              ]
            },
            "description": "Menampilkan daftar produk dengan pagination, pencarian, filter kategori, dan sorting."
          }
        },
        {
          "name": "Get Product Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/products/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "1"
              ]
            },
            "description": "Menampilkan detail produk berdasarkan ID. Tidak memerlukan autentikasi."
          }
        }
      ]
    },
