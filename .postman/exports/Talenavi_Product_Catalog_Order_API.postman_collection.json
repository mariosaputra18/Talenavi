            "description": "Memperbarui quantity item keranjang ID 3. Bearer Token diperlukan."
          }
        },
        {
          "name": "Remove from Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
